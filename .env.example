# Copy to .env (git-ignored). Never commit real values.
TEST_ENV=dev

# Login used by src/setup/auth.setup.ts (Auth0 universal login)
ECOS_TEST_USER_EMAIL=
ECOS_TEST_USER_PASSWORD=

# Optional: skip the browser-captured token and supply one manually (used as-is, no refresh)
# ECOS_AUTH_TOKEN=

# Optional: path of an app endpoint that returns the session token as JSON ({token|accessToken|access_token|idToken}).
# Use only if the browser never sends the Bearer token to the API itself (e.g. everything goes through Next.js server code).
# ECOS_TOKEN_ENDPOINT=/auth/access-token

# Optional overrides of values from src/config/environments/<TEST_ENV>.json
# UI_BASE_URL=
